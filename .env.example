# Public Spotify application identifier; never put a client secret in REACT_APP_*.
REACT_APP_SPOTIFY_CLIENT_ID=
# Optional. Default is the current loopback/HTTPS origin plus /callback.
REACT_APP_REDIRECT_URI=http://127.0.0.1:3000/callback
# Empty uses same-origin /api and the CRA development proxy on port 3001.
REACT_APP_API_URL=
PORT=3001
